{
  "name": "@nexora/web",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend da NEXORA TRADING (React + Vite).",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
